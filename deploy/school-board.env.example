# Настройки панели. Копируется в /etc/school-board.env (права 600).
PORT=3000
HOST=127.0.0.1
DATA_DIR=/var/lib/school-board
TZ_NAME=Europe/Moscow
# Пароль первого директора. Пусто — сервер сам придумает и напечатает в журнале (journalctl -u school-board).
# Пароль всё равно придётся сменить при первом входе.
INITIAL_ADMIN_PASSWORD=
